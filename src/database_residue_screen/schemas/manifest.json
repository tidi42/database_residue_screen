{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned output artifact manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "study_id", "study_sha256", "software", "stage", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "study_id": {"type": "string", "minLength": 1},
    "study_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "software": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "code_sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "code_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "stage": {"enum": ["preflight", "search"]},
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "path", "sha256", "format", "rows"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "format": {"enum": ["json", "tsv"]},
          "rows": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    }
  }
}
