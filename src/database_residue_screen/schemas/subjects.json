{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference-record metadata with explicit unknowns",
  "type": "object", "additionalProperties": false,
  "required": ["raw_id", "accession_version", "length", "topology", "record_type", "taxids", "assembly_id", "project_id", "metadata_source", "metadata_date"],
  "properties": {
    "raw_id": {"type": "string", "minLength": 1},
    "accession_version": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*[.][0-9]+$"},
    "length": {"type": "integer", "minimum": 1},
    "topology": {"enum": ["linear", "circular", "unknown"]},
    "record_type": {"enum": ["genomic", "transcript", "amplicon", "viral", "vector", "synthetic", "unknown"]},
    "taxids": {"type": "string", "pattern": "^([0-9]+(;[0-9]+)*)?$"},
    "assembly_id": {"type": "string"},
    "project_id": {"type": "string"},
    "metadata_source": {"type": "string"},
    "metadata_date": {"type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$"}
  }
}
